# CAMPAIGN ENVIRONMENT -- the OV_* switches every quoted fleet number was measured with.
# The yaml (estimator_flight.yaml / estimator_calib.yaml) is the FILTER operating point; these
# are the tracker/scheduler/algorithm switches read with getenv() and NOT reachable from the
# yaml. They are part of the validated configuration, not an optional accelerator: the
# deterministic oracle reproduces its reference md5s only with this set, and the online node's
# 3.57 cm / p90 16 ms were taken with it. Source it the way flight_stiffness.env is sourced:
#     set -a; source campaign.env; set +a
# Copied verbatim from the campaign online driver BASE string (/home/lis/r41onl.sh on the Orin,
# byte-identical to the kit's templates/r38onl.sh; read 2026-09-02).
#
# PLATFORM: written for an Orin NX (8 cores -> OV_AFFINITY 0-3:4-7, OMP 4 threads, sm_87 GPU
# kernels, Jetson NVJPEG). On a non-Jetson host the GPU tracker cannot run: use the CPU path by
# NOT sourcing this file (accuracy then differs from the campaign numbers -- different tracker).

OV_GPU_CLAHE=0
OV_GPU_EKF=0
OV_GPU_TRACK=1
OV_GPU_CUSTOM_KLT=1
OV_HYBRID_UPDATE=1
OV_OMP_MSCKF=1
OV_QR_HH=1
OV_FULL_DOWNDATE=1
OV_SKIP_ACTIVE_TRACKS=1
OV_BATCH_INIT_UP=1
OV_GROUP_CAMS=1
OV_DETECT_EVERY=10
OV_NOPROF=1
OV_SPREAD_UPD=1
OV_DETECT_STAGGER=1
OV_MAX_INIT_PER_UP=1
OV_RAMP_SECS=8
OV_RAMP_MSCKF=8
OV_ASYNC_UPDATE=0
OMP_NUM_THREADS=4
OV_GPU_KLT_ITERS=30
OV_PAR_QR=1
OV_CHOL_DOWN=1
OV_HH_NULL=1
OV_EKF_SCRATCH=1
OV_MSCKF_SCRATCH=1
OV_DECODE_POOL=1
OV_AFFINITY=0-3:4-7
OV_DET_NOVPI=1
OV_DETECT_SPLIT=1
OV_SPREAD_ADAPT=1
OV_SPREAD_DL_S=0.14
OV_DETECT_BURST_MIN=5
OV_MAX_CLONES=30
OV_RANSAC_OLDFIT=1
OV_PIPELINE=1
OV_NVJPG=1
OV_UNDIST_BATCH=1
OV_KCAND_FULL=1

# SERIAL (bag replay) RUNS ADD, per the campaign's r24sweep.sh BASE: OV_PREFETCH=1 OV_PRESEED=1
# OV_REALTIME=1 -- bag-reader features with no online analogue (run_online_msckf documents them as
# not ported). The serial string did not carry OV_KCAND_FULL=1. The deterministic oracle adds
# OV_DETERMINISTIC=1 (never for flight).
#
# KEEP OFF (default-off gates; every quoted number had them unset): OV_GATE_ALL_LEADS,
# OV_HOLD_PARTIAL, OV_IMU_INTERP, OV_PX4_ODOM, OV_MAX_INIT_STEADY, OV_SLAM_PICK_BEST, OV_DEC_CPU,
# OV_SLAMSTAT, *_VERIFY. OV_PX4_ODOM=1 is what enables the EKF2 bridge publisher for flight.

# ADDED 2026-10-05, after the campaign (not part of its string): publish each pose when its update
# finishes, from the pipeline worker, instead of after the NEXT image set has been tracked.
# Timing only -- the deterministic oracle's trajectory and calibration harvest are byte-identical
# with it on and off (nxt10, nxt3). Measured on the Orin NX with the online node on 3 flights
# (frame-set complete -> pose published, the [online-pose] census): 19 ms instead of 47 ms, and
# 52 ms instead of 80 ms for the 40-60 % of poses whose filter step starts one image set late.
# Needs OV_PIPELINE=1; ignored otherwise.
OV_PUB_WHEN_READY=1
#
# EKF2: this switch alone does NOT make a short EKF2_DELAY_MAX safe. With OV_SPREAD_DL_S left at
# 0.14 s, 40-60 % of poses still leave 52 ms after their images (97 ms after exposure). In the
# EKF2 replay with measured arrival times (7 flights) the fused output at 200 ms is the same with
# the switch on or off (4.3 cm), and every shorter limit tested (150 to 90 ms) leaves gaps of more
# than 0.2 s without vision on at least one flight. Keep EKF2_DELAY_MAX at 200 ms.
#
# NOT ADOPTED HERE: OV_SPREAD_DL_S=0.12 on top removes the late case (99 % of poses at 19 ms on
# nxt10), because a sub-update left over from the previous filter step is then force-drained
# together with the new step's first one. It is NOT timing-only -- the oracle trajectory changes --
# so it needs its own accuracy validation (paired online draws) before it replaces 0.14.
