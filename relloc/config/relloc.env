# relloc: cross-drone relative localization (relloc/README.md). Source this file, then start scripts/run_relloc.sh on every drone.
# Everything is off until RELLOC=1.
#
#   RELLOC                  1 = run the relative localization (run_relloc.sh does nothing otherwise)
#   RELLOC_6DOF             1 = the 6-DoF output drives the lock (withdraws and re-searches) and is the primary `transform`;
#                           0 = the 4-DoF output does (the deployed relloc2 configuration). Both outputs are published either way.
#   RELLOC_ID               this drone's number 0-255 (default: the last number in the hostname, nxt3 -> 3)
#   RELLOC_FLIGHT_DIR       the drone's flight folder (selfcalib/tool/deploy_vio.py output): chain, lens terms, camera topics
#   RELLOC_TRANSPORT        how the datagrams travel between the drones (README "Between the drones"): ros2 = one best-effort ROS 2
#                           message per datagram on /relloc/dg/d<RELLOC_ID>; udp = raw UDP to RELLOC_DEST
#   RELLOC_ROS_DOMAIN       ros2: the ROS domain of the datagram topics, which every drone's relloc joins and nothing else does (a second
#                           DDS participant inside relloc; cameras, VIO and PX4 stay in the drone's own domain). 100: no drone number
#                           and not the ground station's 0, and within 0-101, whose DDS ports stay below Linux's ephemeral ports. One
#                           value per network: drone numbers must be unique in it. Empty: the node's own domain; the fleet's
#                           domain_bridge must then forward /relloc/dg/d<k> to the other drones (README)
#   RELLOC_ROS_DEPTH        ros2: history depth of the datagram topics (at least 72 = two bursts of 36 datagrams)
#   RELLOC_DEST             udp: where the datagrams go: host:port list of the other drones (unicast), or 255.255.255.255:47800 (broadcast)
#   RELLOC_PORT             udp: the port this drone listens on
#   RELLOC_TAKEOFF_DZ       the take-off latch: VIO height (m) above its first pose. Every keyframe from the first VIO pose is
#                           processed (the first keyframes sent have partners from the ground and the start of the climb); packets
#                           leave, and own keyframes enter the receiver, from the latch on. -1 = no latch: sends from the first VIO
#                           pose, on the ground
#   RELLOC_TAKEOFF_HOLD_S   seconds after the latch before the drone sends and solves (0 = at the latch)
#   RELLOC_PARMIN_EARLY_DEG parallax floor (deg) of every triangulated point until the latch + RELLOC_PARMIN_EARLY_S (relloc2 review24
#   RELLOC_PARMIN_EARLY_S   rule PT8F6G8: 8 deg for 8 s, then RELLOC_PARMIN_DEG 6 deg); before the latch the early floor applies
#   RELLOC_PARMIN_DEG       the floor after the switch
#   RELLOC_MEM_GATE_DEG     a keyframe becomes a camera's depth memory only when >= 100 of its points reach this parallax, and only those
#                           points are stored (0 = no gate). relloc2's previous setting (C2): PARMIN 3, PARMIN_EARLY 3, MEM_GATE 0
#   RELLOC_XFEAT_ENGINE     XFeat backend. auto: the TensorRT engine at ~/relloc_engines/xfeat_b4_800x1280_fp16.engine when it exists
#                           (build it once on each drone: python3 relloc/scripts/build_xfeat_engine.py), else PyTorch with a warning;
#                           torch: PyTorch; a path: that engine (required)
#   RELLOC_LOG_DIR          one jsonl log per run (every keyframe, solve, lock, output) for grading against motion capture
#   Inputs (defaults = the flight stack): RELLOC_POSE_TOPIC (/poseimu, run_online_msckf), RELLOC_IMU_TOPIC (imu_topic of the folder's
#   estimator_flight.yaml, else /fmu/out/sensor_combined),
#   RELLOC_CAM_TOPICS (comma list; default cam_topic0..3 of estimator_flight.yaml), RELLOC_POSE_MSG_TYPE, RELLOC_IMU_MSG_TYPE,
#   RELLOC_CAM_MSG_TYPE. Outputs: RELLOC_TOPIC (relloc) -> relloc/peer<id>/transform, transform_4dof, transform_6dof, position, relloc/status.
RELLOC=0
RELLOC_6DOF=0
RELLOC_ID=
RELLOC_FLIGHT_DIR=
RELLOC_TRANSPORT=ros2
RELLOC_ROS_DOMAIN=100
RELLOC_ROS_DEPTH=128
RELLOC_DEST=255.255.255.255:47800
RELLOC_PORT=47800
RELLOC_TAKEOFF_DZ=0.5
RELLOC_TAKEOFF_HOLD_S=0
RELLOC_PARMIN_EARLY_DEG=8
RELLOC_PARMIN_EARLY_S=8
RELLOC_PARMIN_DEG=6
RELLOC_MEM_GATE_DEG=8
RELLOC_XFEAT_ENGINE=auto
RELLOC_LOG_DIR=~/relloc_logs
RELLOC_POSE_TOPIC=/poseimu
